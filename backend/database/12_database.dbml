// dbdiagram.io Database Markup Language (DBML)
// เว็บแอปพลิเคชันคลังคำศัพท์ Flashcard ช่วยจำสอบภาษาอังกฤษ (พร้อมระบบทดสอบ Quiz)

Table users {
  user_id int [pk, increment]
  username varchar(50) [not null]
  email varchar(100) [not null]
  password_hash varchar(255) [not null]
  student_id varchar(20)
  full_name varchar(100)
  created_at timestamp
}

Table categories {
  category_id int [pk, increment]
  category_name varchar(50) [not null]
}

Table flashcards {
  card_id int [pk, increment]
  user_id int [not null]
  category_id int
  vocab_word varchar(100) [not null]
  part_of_speech varchar(20)
  meaning_th varchar(255) [not null]
  example_sentence text
  is_remembered boolean
  created_at timestamp
}

Table quizzes {
  quiz_id int [pk, increment]
  user_id int [not null]
  category_id int
  score int [not null, default: 0]
  total_questions int [not null, default: 5]
  tested_at timestamp
}

Table quiz_answers {
  answer_id int [pk, increment]
  quiz_id int [not null]
  card_id int [not null]
  selected_choice varchar(255) [not null]
  is_correct boolean [not null]
}

Ref: users.user_id < flashcards.user_id
Ref: categories.category_id < flashcards.category_id
Ref: users.user_id < quizzes.user_id
Ref: categories.category_id < quizzes.category_id
Ref: quizzes.quiz_id < quiz_answers.quiz_id
Ref: flashcards.card_id < quiz_answers.card_id
